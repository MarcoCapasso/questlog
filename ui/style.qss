/* Finestra e testo di base */

QMainWindow {
    background-color: #101214;
}

QWidget {
    color: #F1F3F5;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* Barra di navigazione */

QFrame#header {
    border: none;
    border-bottom: 1px solid #2A2F35;
}

QLabel#logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 1px;
    padding-right: 24px;
}

QPushButton#navButton {
    background-color: transparent;
    color: #C2C8CF;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton#navButton:hover {
    background-color: #1C2024;
    color: #FFFFFF;
}

QPushButton#navButton:checked {
    background-color: #F1F3F5;
    color: #101214;
    font-weight: 700;
}

/* Pagine e scorrimento */

QLabel#pageTitle {
    font-size: 28px;
    font-weight: 800;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #2A2F35;
    border-radius: 5px;
    min-height: 40px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Card dei giochi */

QLabel#cover {
    background-color: #23282E;
    border-radius: 8px;
}

QLabel#statusChip {
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 700;
    background-color: #2A2F35;
    color: #F1F3F5;
}

QLabel#statusChip[status="playing"] {
    background-color: #8FE0A8;
    color: #0E2415;
}

QLabel#statusChip[status="completed"] {
    background-color: #F1F3F5;
    color: #101214;
}

QLabel#statusChip[status="dropped"] {
    background-color: #F2B48C;
    color: #2A1608;
}

QLabel#extraChip {
    border: 1px solid #4A5058;
    border-radius: 10px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: 700;
    background-color: transparent;
    color: #C2C8CF;
}

QLabel#cardTitle {
    font-size: 15px;
    font-weight: 600;
}

QLabel#cardDetails {
    font-size: 13px;
    color: #AEB5BD;
}

QToolTip {
    background-color: #1C2024;
    color: #F1F3F5;
    border: 1px solid #2A2F35;
    padding: 6px 8px;
}

QLabel#libraryChip {
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 700;
    background-color: #8FE0A8;
    color: #0E2415;
}

/* Catalogo */

QLineEdit#catalogSearch {
    border-radius: 22px;
    padding: 11px 20px;
    font-size: 15px;
}

QLabel#sectionTitle {
    font-size: 20px;
    font-weight: 700;
}

QLabel#sectionMessage {
    color: #AEB5BD;
}

QLabel#demoNotice {
    color: #E3B873;
    font-size: 13px;
}

/* Pagina del gioco */

QLabel#gameTitle {
    font-size: 40px;
    font-weight: 800;
}

QLabel#gameMeta {
    font-size: 14px;
    color: #AEB5BD;
}

QLabel#gameSummary {
    font-size: 15px;
    color: #D5DAE0;
}

QFrame#playthroughRow {
    background-color: #181B1F;
    border-radius: 12px;
}

QLabel#playthroughHours {
    font-size: 22px;
    font-weight: 800;
}

/* Ricerca e filtri */

QLineEdit {
    background-color: #1C2024;
    border: 1px solid transparent;
    border-radius: 18px;
    padding: 8px 14px;
    color: #F1F3F5;
    selection-background-color: #8FE0A8;
    selection-color: #0E2415;
}

QLineEdit:focus {
    border: 1px solid #4A5058;
}

QPushButton#filtersButton {
    background-color: #1C2024;
    color: #F1F3F5;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#filtersButton:hover {
    background-color: #252A30;
}

QMenu {
    background-color: #1C2024;
    border: 1px solid #2A2F35;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 16px 8px 30px;
    border-radius: 6px;
    color: #F1F3F5;
}

QMenu::item:selected {
    background-color: #2A2F35;
}

QMenu::item:checked {
    font-weight: 700;
}

/* Bottoni */

QPushButton {
    background-color: #1C2024;
    color: #F1F3F5;
    border: 1px solid #2A2F35;
    border-radius: 16px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #252A30;
}

QPushButton#primaryButton {
    background-color: #F1F3F5;
    color: #101214;
    border: 1px solid #F1F3F5;
}

QPushButton#primaryButton:hover {
    background-color: #FFFFFF;
}

QPushButton#backButton {
    background-color: transparent;
    border: 1px solid transparent;
    color: #AEB5BD;
    padding: 6px 0px;
    font-weight: 600;
}

QPushButton#backButton:hover {
    color: #FFFFFF;
}

/* Form */

QLabel#formLabel {
    min-height: 38px;
    color: #C2C8CF;
}

QLabel#formError {
    color: #FF9B9B;
}

QFrame#formPanel {
    background-color: #16191C;
    border: 1px solid #2A2F35;
    border-radius: 14px;
}

QLabel#formTitle {
    font-size: 18px;
    font-weight: 700;
}

QToolButton#closeButton {
    background: transparent;
    border: none;
    border-radius: 14px;
    color: #AEB5BD;
    font-size: 14px;
    min-width: 28px;
    min-height: 28px;
}

QToolButton#closeButton:hover {
    background-color: #2A2F35;
    color: #FFFFFF;
}

QLabel#fieldCaption {
    color: #8A929B;
    font-size: 12px;
    font-weight: 600;
}

QLineEdit#formInput {
    border-radius: 8px;
    padding: 8px 12px;
}

QPushButton#pillButton {
    background-color: transparent;
    color: #C2C8CF;
    border: 1px solid #343A41;
    border-radius: 16px;
    padding: 7px 16px;
    font-weight: 600;
}

QPushButton#pillButton:hover {
    border: 1px solid #5A6169;
    color: #FFFFFF;
}

QPushButton#pillButton:checked {
    background-color: #F1F3F5;
    border: 1px solid #F1F3F5;
    color: #101214;
}

QPushButton#pillButton[status="playing"]:checked {
    background-color: #8FE0A8;
    border: 1px solid #8FE0A8;
    color: #0E2415;
}

QPushButton#pillButton[status="dropped"]:checked {
    background-color: #F2B48C;
    border: 1px solid #F2B48C;
    color: #2A1608;
}

QComboBox QLineEdit,
QComboBox QLineEdit:focus {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
}

QComboBox,
QDateEdit,
QFrame#hoursInput {
    background-color: #1C2024;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 24px;
    color: #F1F3F5;
}

QComboBox:focus,
QDateEdit:focus,
QFrame#hoursInput[focused="true"] {
    border: 1px solid #4A5058;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 32px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url({icons}/chevron-down.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #1C2024;
    border: 1px solid #2A2F35;
    selection-background-color: #2A2F35;
    color: #F1F3F5;
}

QFrame#hoursInput {
    padding: 0px;
}

QLineEdit#hoursNumber,
QLineEdit#hoursNumber:focus {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
}

QLabel#hoursUnit {
    color: #AEB5BD;
}

/* Calendario */

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #1C2024;
    padding: 6px 4px;
}

QCalendarWidget QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #F1F3F5;
    font-size: 15px;
    font-weight: 700;
    padding: 6px 10px;
}

QCalendarWidget QToolButton:hover {
    background-color: #2A2F35;
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url({icons}/chevron-left.svg);
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url({icons}/chevron-right.svg);
}

QCalendarWidget QSpinBox {
    background-color: #2A2F35;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    color: #F1F3F5;
    selection-background-color: #8FE0A8;
    selection-color: #0E2415;
}

QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
    width: 0px;
    border: none;
}

QCalendarWidget QAbstractItemView {
    background-color: #1C2024;
    color: #F1F3F5;
    outline: 0;
    font-size: 13px;
    selection-background-color: transparent;
    selection-color: #F1F3F5;
}

QCheckBox {
    spacing: 10px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #4A5058;
    border-radius: 5px;
    background-color: #1C2024;
}

QCheckBox::indicator:hover {
    border: 1px solid #8A929B;
}

QCheckBox::indicator:checked {
    background-color: #8FE0A8;
    border: 1px solid #8FE0A8;
    image: url({icons}/check.svg);
}

/* Carosello */

QToolButton#carouselArrow {
    background-color: rgba(16, 18, 20, 180);
    border: none;
    border-radius: 20px;
}

QToolButton#carouselArrow:hover {
    background-color: rgba(16, 18, 20, 230);
}

QLabel#carouselCounter {
    background-color: rgba(16, 18, 20, 180);
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 700;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #2A2F35;
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QToolButton#ratingStar {
    background: transparent;
    border: none;
    padding: 2px;
}
