/* Finestra e testo di base */

QMainWindow {
    background-color: #101214;
}

QWidget {
    color: #F1F3F5;
    font-family: "Segoe UI";
    font-size: 14px;
}

/* Barra di navigazione */

QFrame#header {
    border: none;
    border-bottom: 1px solid #2A2F35;
}

QLabel#logo {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 1px;
    padding-right: 24px;
}

QPushButton#navButton {
    background-color: transparent;
    color: #C2C8CF;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton#navButton:hover {
    background-color: #1C2024;
    color: #FFFFFF;
}

QPushButton#navButton:checked {
    background-color: #F1F3F5;
    color: #101214;
    font-weight: 700;
}

/* Pagine e scorrimento */

QLabel#pageTitle {
    font-size: 28px;
    font-weight: 800;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #2A2F35;
    border-radius: 5px;
    min-height: 40px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Card dei giochi */

QLabel#cover {
    background-color: #23282E;
    border-radius: 8px;
}

QLabel#statusChip {
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 700;
    background-color: #2A2F35;
    color: #F1F3F5;
}

QLabel#statusChip[status="playing"] {
    background-color: #8FE0A8;
    color: #0E2415;
}

QLabel#statusChip[status="completed"] {
    background-color: #F1F3F5;
    color: #101214;
}

QLabel#statusChip[status="dropped"] {
    background-color: #F2B48C;
    color: #2A1608;
}

QLabel#extraChip {
    border: 1px solid #4A5058;
    border-radius: 10px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: 700;
    background-color: transparent;
    color: #C2C8CF;
}

QLabel#cardTitle {
    font-size: 15px;
    font-weight: 600;
}

QLabel#cardDetails {
    font-size: 13px;
    color: #AEB5BD;
}

QToolTip {
    background-color: #1C2024;
    color: #F1F3F5;
    border: 1px solid #2A2F35;
    padding: 6px 8px;
}

/* Ricerca e filtri */

QLineEdit {
    background-color: #1C2024;
    border: 1px solid transparent;
    border-radius: 18px;
    padding: 8px 14px;
    color: #F1F3F5;
    selection-background-color: #8FE0A8;
    selection-color: #0E2415;
}

QLineEdit:focus {
    border: 1px solid #4A5058;
}

QPushButton#filtersButton {
    background-color: #1C2024;
    color: #F1F3F5;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#filtersButton:hover {
    background-color: #252A30;
}

QPushButton#filtersButton::menu-indicator {
    image: none;
    width: 0px;
}

QMenu {
    background-color: #1C2024;
    border: 1px solid #2A2F35;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 16px 8px 30px;
    border-radius: 6px;
    color: #F1F3F5;
}

QMenu::item:selected {
    background-color: #2A2F35;
}

QMenu::item:checked {
    font-weight: 700;
}

/* Bottoni e finestre di dialogo */

QPushButton {
    background-color: #1C2024;
    color: #F1F3F5;
    border: 1px solid #2A2F35;
    border-radius: 16px;
    padding: 8px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #252A30;
}

QPushButton#primaryButton,
QDialogButtonBox QPushButton:default {
    background-color: #F1F3F5;
    color: #101214;
    border: 1px solid #F1F3F5;
}

QPushButton#primaryButton:hover,
QDialogButtonBox QPushButton:default:hover {
    background-color: #FFFFFF;
}

QDialog {
    background-color: #15181B;
}

QLabel#formError {
    color: #FF9B9B;
}