# Copia questo file come ".env" e inserisci le tue chiavi.
# Il file .env è in .gitignore: non finisce mai su GitHub.

# Credenziali dell'app Twitch per il catalogo IGDB
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Facoltativa: chiave DeepL per tradurre in italiano le descrizioni
DEEPL_API_KEY=

# Progetto Supabase: URL e chiave pubblica (publishable/anon). Mai la chiave secret/service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
